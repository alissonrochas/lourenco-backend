# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reverse proxy addresses allowed to supply forwarded IP headers
# Keep 'loopback' unless deployed behind a known proxy; never accept wildcard/trusted-all
TRUST_PROXY=loopback